# Copy this file to .env and fill in your own values. Never commit the real .env.

# Pairiquium HTTP API base URL (no trailing path, e.g. https://tickets.pairiquium.com)
HTTP_URL=

# Your secret Pairiquium API key (X-MaaS-API-Key). Keep this on the backend only - it is never
# sent to or held by the Unity client.
API_KEY=

# Local port this backend listens on. Must match what you tell ngrok to tunnel, and what the
# Unity sample's ArenaDuelSample.ticketEndpointUrl points at.
PORT=8787
